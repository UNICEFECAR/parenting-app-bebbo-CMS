{
    "name": "acquia/blt-project",
    "type": "project",
    "description": "Project template for Drupal 8 sites built with BLT.",
    "license": "GPL-3.0-only",
    "require": {
        "php": ">=8.4",
        "acquia/drupal-spec-tool": "^6.1",
        "acquia/memcache-settings": "*",
        "composer/installers": "^2.2",
        "cweagans/composer-patches": "~1.0",
        "drupal/access_policy": "^2",
        "drupal/acquia_connector": "^4.0",
        "drupal/acquia_purge": "^1.4",
        "drupal/admin_toolbar": "^3.6",
        "drupal/ai": "^1.4",
        "drupal/ai_provider_openai": "^1.2",
        "drupal/ai_tmgmt": "^1.0@beta",
        "drupal/ai_translate": "^1.3",
        "drupal/allowed_languages": "^2.0",
        "drupal/auto_entitylabel": "^3.4",
        "drupal/autocomplete_id": "^1.7",
        "drupal/better_exposed_filters": "^7.1",
        "drupal/cloudflare": "^2.0@beta",
        "drupal/color": "^1.0",
        "drupal/config_ignore": "^3.4",
        "drupal/config_split": "^2.0",
        "drupal/config_update": "^2.0@alpha",
        "drupal/consumers": "^1.24",
        "drupal/content_moderation_notifications": "^3.7",
        "drupal/contextual_range_filter": "^3.0",
        "drupal/core-composer-scaffold": "^11.2",
        "drupal/core-project-message": "^11.2",
        "drupal/core-recommended": "^11.2",
        "drupal/csv_serialization": "^4.0",
        "drupal/date_popup": "^2.0",
        "drupal/devel": "^5.4",
        "drupal/drupal-extension": "dev-main",
        "drupal/email_tfa": "^3.0",
        "drupal/entity": "^1.6",
        "drupal/entity_reference_revisions": "*",
        "drupal/entity_reference_validators": "^2.0",
        "drupal/entity_share": "^3.13",
        "drupal/entity_share_cron": "^3.0",
        "drupal/entity_update": "^3.0",
        "drupal/features": "^3.8.0",
        "drupal/feeds": "^3.2",
        "drupal/feeds_tamper": "^2.0@RC",
        "drupal/file_mdm": "^3.1",
        "drupal/filelog": "^3.0",
        "drupal/fpa": "^4.0",
        "drupal/gin": "^5.0",
        "drupal/gin_toolbar": "^3.0",
        "drupal/google_analytics": "^4.0",
        "drupal/group": "^3",
        "drupal/image_style_quality": "^1.7",
        "drupal/imageapi_optimize": "^4.2",
        "drupal/imageapi_optimize_avif_webp": "^1.3",
        "drupal/imageapi_optimize_binaries": "^1.2@beta",
        "drupal/imageapi_optimize_gd": "^2.0",
        "drupal/imageapi_optimize_webp": "^2.1",
        "drupal/imagemagick": "*",
        "drupal/inline_entity_form": "^3.0@RC",
        "drupal/json_field": "^1.5",
        "drupal/jsonapi_extras": "^3.28",
        "drupal/jsonapi_page_limit": "^1.1",
        "drupal/key": "^1.22",
        "drupal/lang_dropdown": "^2.4",
        "drupal/languagefield": "^1.14",
        "drupal/layout_builder_styles": "^2.1",
        "drupal/layout_custom_section_classes": "^1.0",
        "drupal/layout_section_classes": "^1.3",
        "drupal/lazy": "^4.0",
        "drupal/linked_field": "^1.7",
        "drupal/memcache": "^2.8",
        "drupal/menu_export": "^1.7",
        "drupal/menu_link_attributes": "^1.7",
        "drupal/menu_per_role": "^1.3",
        "drupal/metatag": "^2.2",
        "drupal/migrate_plus": "^6.0",
        "drupal/migrate_source_csv": "^3.8",
        "drupal/migrate_tools": "^6.1",
        "drupal/migrate_upgrade": "^4.0",
        "drupal/mobile_app_links": "^2.0",
        "drupal/mysql57": "^1.0",
        "drupal/paragraphs": "^1.20",
        "drupal/pathauto": "^1.15",
        "drupal/quickedit": "^2.0",
        "drupal/rdf": "^3.0@beta",
        "drupal/redirect": "^1.13",
        "drupal/restui": "^1.20",
        "drupal/seckit": "^2.0",
        "drupal/security_review": "^3.1",
        "drupal/shield": "^1.2.0",
        "drupal/simple_oauth": "^6.1",
        "drupal/smtp": "^1.0",
        "drupal/stage_file_proxy": "^3.1",
        "drupal/structure_sync": "^2.0",
        "drupal/svg_image": "^3.2",
        "drupal/symfony_mailer": "^1.4",
        "drupal/symfony_mailer_office365": "^1.0@alpha",
        "drupal/tamper": "^1.0@beta",
        "drupal/title_length": "^2.1",
        "drupal/tmgmt": "^1.15",
        "drupal/tmgmt_deepl": "^2.2",
        "drupal/tmgmt_google": "^1.1",
        "drupal/tmgmt_memsource": "^1.27",
        "drupal/tmgmt_microsoft": "^1.2",
        "drupal/token": "^1.17",
        "drupal/toolbar_menu": "^3.1",
        "drupal/toolbar_menu_clean": "^2.0",
        "drupal/ultimate_cron": "^2.0@alpha",
        "drupal/video_embed_field": "^3.1",
        "drupal/video_embed_media": "^2.4",
        "drupal/view_custom_table": "2.0.8",
        "drupal/views_bulk_operations": "^4.4",
        "drupal/views_data_export": "^1.10",
        "drupal/views_field_view": "^1.0",
        "drupal/warmer": "^2.0",
        "drupal/webp": "^1.0@RC",
        "drush/drush": "^13",
        "enshrined/svg-sanitize": "^0.22.0",
        "firebase/php-jwt": "^7.0@stable",
        "mglaman/composer-drupal-lenient": "^2.0",
        "npm-asset/js-cookie": "^3.0",
        "oomphinc/composer-installers-extender": "^2.0",
        "spomky-labs/cbor-php": "^3.0",
        "webflo/drupal-finder": "^1.3.1"
    },
    "config": {
        "platform": {
            "php": "8.4"
        },
        "sort-packages": true,
        "discard-changes": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "grasmash/drupal-security-warning": true,
            "mglaman/composer-drupal-lenient": true,
            "oomphinc/composer-installers-extender": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "composer-exit-on-patch-failure": true,
        "drupal-scaffold": {
            "locations": {
                "web-root": "./docroot"
            },
            "file-mapping": {
                "[web-root]/sites/default/default.services.yml": {
                    "mode": "replace",
                    "path": "docroot/core/assets/scaffold/files/default.services.yml",
                    "overwrite": false
                },
                "[web-root]/sites/default/default.settings.php": {
                    "mode": "replace",
                    "path": "docroot/core/assets/scaffold/files/default.settings.php",
                    "overwrite": false
                },
                "[web-root]/.htaccess": false
            }
        },
        "enable-patching": true,
        "installer-paths": {
            "docroot/core": [
                "type:drupal-core"
            ],
            "docroot/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "docroot/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "docroot/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "docroot/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "docroot/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "docroot/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ],
            "docroot/libraries/{$name}": [
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "drush/Commands/{$name}": [
                "type:drupal-drush"
            ]
        },
        "installer-types": [
            "bower-asset",
            "npm-asset"
        ],
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {
            "drupal/allowed_languages": {
                "Content translation edit/delete access reads {target} instead of {language}, so it tests the page content language: denies assigned languages under /en and grants unassigned ones under a language prefix": "patches/allowed_languages/content-translation-edit-uses-language-param.patch"
            },
            "drupal/ai": {
                "Preserve HTML in streamed output - hold flush buffer until tags balance (3586558, MR !1734)": "patches/ai/preserve-html-in-streamed-output-3586558-mr1734.patch"
            },
            "drupal/csv_serialization": {
                "Fix league/csv 9.27 deprecations: createFromFileObject/createFromString (3562555)": "patches/csv_serialization_league_csv_deprecation-3562555.patch"
            },
            "drupal/entity_share": {
                "PHP 8.4: explicit nullable params (issue 3553318, won't-fix on 3.x; fixed in 4.0.x)": "patches/entity_share/php84-implicit-nullable-3553318.patch",
                "D11/core 10.2+: remove dangling canonical link templates -> RouteNotFoundException on channel/remote list (3419256, MR!89)": "patches/entity_share/canonical-link-template-3419256.patch"
            },
            "drupal/views_data_export": {
                "Batch export loses entity_type query metadata -> PluginNotFoundException with Group access (3173296)": "patches/views_data_export/batch-query-metadata-3173296.patch"
            },
            "drupal/core": {
                "Fix moderation issue for translation": "patches/content_moderation/content_moderation_revision.patch",
                "Field translated field issue fixed": "https://www.drupal.org/files/issues/2024-05-01/3025039-94.patch"
            },
            "drupal/view_custom_table": {
                "Defensive checks in views_data to avoid fatal on malformed config": "patches/view_custom_table/safe_views_data.patch"
            },
            "drupal/video_embed_field": {
                "Fixed the issue -Mapping for Feeds module missing": "https://www.drupal.org/files/issues/2019-09-02/3056385-feeds-mapping-missing-5.patch"
            },
            "drupal/tmgmt": {
                "Added custom filter in source page like node id and country": "patches/tmgmt/custom_filter_in_tmgmt_source_page.patch",
                "Update the Entity Author Details": "patches/tmgmt/tmgmt_revision.patch",
                "Fix JobType grouped filter passing array to escapeLike": "patches/tmgmt/tmgmt_job_type_grouped_filter_fix.patch",
                "Contact only the selected provider when building the job form": "patches/tmgmt/tmgmt_probe_only_selected_provider.patch"
            },
            "drupal/tmgmt_memsource": {
                "PHP 8.4: explicit nullable param in createFileTranslation": "patches/tmgmt_memsource-implicit-nullable-php84.patch"
            },
            "drupal/imagemagick": {
                "Fix derivative generation - preserve URL-encoded filenames": "patches/imagemagick/fix-url-encoded-filenames.patch"
            },
            "drupal/date_popup": {
                "Add 1 day to the end so the query will include the selected date.": "https://www.drupal.org/files/issues/2020-10-18/range-selection-end-date-2983680-7.patch"
            },
            "drupal/mobile_app_links": {
                "Updated wellknown_controller to accomodate android and ios response": "patches/mobile_app_links/wellknown_controller.patch",
                "PHP 8.4: explicit nullable params in processOutbound (MR!14)": "patches/mobile_app_links/php84-implicit-nullable.patch"
            },
            "drupal/content_moderation_notifications": {
                "Doesn't work on multilingual entities": "https://www.drupal.org/files/issues/2019-10-23/2949891-multi-language-moderation-against-rc2--10.patch"
            },
            "drupal/views_bulk_operations": {
                "Call to a member function isAllowed": "https://www.drupal.org/files/issues/2022-11-23/3323324-3.patch"
            },
            "drupal/filelog": {
                "Circular reference fix": "https://www.drupal.org/files/issues/2024-08-01/3416342-12.patch",
                "Drupal 11 compatibility (3464223)": "patches/filelog-d11-compatibility.patch"
            },
            "drupal/lang_dropdown": {
                "Fix InvalidArgumentException when no route object exists (404/403 pages)": "https://www.drupal.org/files/issues/2024-02-28/lang_dropdown_InvalidArgumentException.patch"
            },
            "drupal/gin": {
                "Contextual Edit toolbar tab always renders highlighted: unqualified selector in the Inline Edit toggle block": "patches/gin/contextual-edit-toolbar-tab-always-highlighted.patch"
            },
            "webflo/drupal-finder": {
                "Uncaught TypeError fix": "patches/drupal_finder/drupal-finder-fix-start-path.patch"
            },
            "drupal/webp": {
                "Do not regenerate webp": "https://www.drupal.org/files/issues/2024-07-12/webp-stampede-prevention-3177103-32.patch",
                "PHP 8.4: explicit nullable params + constructor param order (3561953 / MR!54)": "patches/webp/php84-implicit-nullable-3561953.patch"
            },
            "drupal/config_split": {
                "Fix collection complete_list matching during export (language overrides going to config/sync instead of split dir)": "patches/config_split/fix-collection-complete-list-matching.patch"
            },
            "drupal/inline_entity_form": {
                "Allow modules to override translation restriction on IEF add new": "patches/inline_entity_form/allow-new-on-translation.patch"
            },
            "drupal/autocomplete_id": {
                "Filter unpublished entities from ID-based autocomplete results": "patches/autocomplete_id/filter_unpublished_entities.patch"
            },
            "drupal/menu_export": {
                "Fix drush command calling protected exportMenus method": "patches/menu_export_drush_visibility.patch"
            },
            "drupal/ai_translate": {
                "Stamp revision date, author and log message on AI generated translations": "patches/ai_translate/stamp-revision-metadata-on-ai-translation.patch"
            },
            "drupal/contextual_range_filter": {
                "Fix PHP 8.4 implicit nullable deprecation in DateRange::init() (https://www.drupal.org/i/3521312)": "patches/contextual_range_filter/3521312-implicit-nullable-php84.patch"
            },
            "drupal/symfony_mailer_office365": {
                "Pass event dispatcher to EsmtpTransport so MessageEvent fires (SendAsDenied fix)": "patches/symfony_mailer_office365-pass-event-dispatcher.patch"
            },
            "drupal/structure_sync": {
                "PHP 8.4: explicit nullable params (3563762)": "patches/structure_sync-implicit-nullable-php84-3563762.patch"
            },
            "drupal/migrate_source_csv": {
                "Fix league/csv 9.27 createFromStream deprecation": "patches/migrate_source_csv-league_csv_deprecation.patch"
            },
            "drupal/ultimate_cron": {
                "D11: legacy #ajax 'replace' method breaks scheduler/logger switch on the job edit form (3535416, MR!71)": "patches/ultimate_cron/ajax-replacewith-3535416.patch"
            },
            "drupal/tmgmt_google": {
                "Do not print a page-level error when the job form incidentally probes Google": "patches/tmgmt_google/no_global_error_on_incidental_probe.patch"
            },
            "drupal/warmer": {
                "CDN warmer aborts cold pages at the 30s http_client default timeout": "patches/warmer/cdn-warmer-request-timeout.patch"
            }
        },
        "drupal-lenient": {
            "allowed-list": [
                "drupal/filelog",
                "drupal/entity_share_cron",
                "drupal/imageapi_optimize_gd",
                "drupal/imageapi_optimize_avif_webp",
                "drupal/color",
                "drupal/video_embed_media"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "Example\\": "blt/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Drupal\\Tests\\PHPUnit\\": "tests/phpunit/src/"
        }
    },
    "repositories": {
        "drupal": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        "asset-packagist": {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "install-git-hooks": [
            "if [ -d .git ] && [ -f scripts/git-hooks/pre-commit ] && [ -z \"$CI\" ] && [ -z \"$ACQUIA_HOSTING_DRUPAL_LOG\" ]; then cp scripts/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit && echo 'Git pre-commit hook installed.'; fi"
        ],
        "post-install-cmd": [
            "@install-git-hooks"
        ],
        "post-update-cmd": [
            "@install-git-hooks"
        ],
        "nuke": [
            "rm -rf vendor composer.lock docroot/core docroot/modules/contrib docroot/profiles/contrib docroot/themes/contrib",
            "@composer clearcache --ansi",
            "@composer install --ansi"
        ]
    },
    "require-dev": {
        "drupal/coder": "^8.3",
        "mglaman/drupal-check": "^1.5",
        "mglaman/phpstan-drupal": "^1.1",
        "mikey179/vfsstream": "^1.6",
        "overtrue/phplint": "^9.0",
        "phpspec/prophecy-phpunit": "^2",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-deprecation-rules": "^1.1",
        "phpunit/phpunit": "^11.5",
        "symfony/phpunit-bridge": "^6.4"
    }
}
