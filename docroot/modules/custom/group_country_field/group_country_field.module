<?php

/**
 * @file
 * It contains group field module.
 */

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Language\LanguageInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\group\Entity\Group;
use Drupal\tmgmt\JobInterface;
use Drupal\tmgmt\JobItemInterface;
use Drupal\user\Entity\Role;
use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\views\Plugin\views\query\Sql;
use Drupal\views\ViewExecutable;

/**
 * Implements form alter.
 */
function group_country_field_form_alter(array &$form, FormStateInterface $form_state, $form_id) {

  if ($form['#id'] == "tmgmt-job-item-edit-form") {
    $user = \Drupal::currentUser();
    $user_roles = $user->getRoles();

    if (in_array('administrator', $user_roles) !== TRUE) {

      $roles_permissions = [];
      foreach ($user_roles as $role_id) {
        $role = Role::load($role_id);
        if ($role) {
          $roles_permissions[$role_id] = $role->getPermissions();
        }
      }

      $new_default_state = ["review_after_translation" => "Review_after_translation"];
      if (!empty($roles_permissions['global_admin'])) {
        if (in_array("administer nodes", $roles_permissions['global_admin'])) {
          $form['moderation_state']['new_state']['#options'] = $form['moderation_state']['new_state']['#options'];
        }
      }
      elseif (!empty($roles_permissions['editor'])) {
        $new_default_state = ["review_after_translation" => "Review_after_translation", "draft" => "Draft"];
        $form['moderation_state']['new_state']['#options'] = $new_default_state;
      }
      else {
        $form['moderation_state']['new_state']['#options'] = $new_default_state;
      }

    }
  }
}

/**
 * Implements views query alter.
 */
function group_country_field_views_query_alter(ViewExecutable $view, QueryPluginBase $query) {
  if ($view->id() == 'duplicate_of_moderated_group_relationship') {
    group_country_field_views_query_alter_moderated_group($view, $query);
    return;
  }

  if (in_array($view->id(), ['tmgmt_job_overview', 'tmgmt_translation_all_job_items'], TRUE)) {
    group_country_field_views_query_alter_tmgmt_jobs($view, $query);
    return;
  }

  if ($view->id() == "recent_logged_in_users") {
    $user = \Drupal::currentUser();
    /* $user_roles = $user->getRoles(); */
    $groups = [];
    $grp_membership_service = \Drupal::service('group.membership_loader');
    $grps = $grp_membership_service->loadByUser($user);
    foreach ($grps as $grp) {
      $groups[] = $grp->getGroup();
    }
    if (!empty($groups)) {
      $title = $groups[0]->label();
      // @phpstan-ignore-next-line
      foreach ($query->where as &$condition_group) {
        foreach ($condition_group['conditions'] as &$condition) {
          if ($condition['field'] == "groups_field_data_group_relationship_field_data.label") {
            $condition['value'] = $title;
            /* $condition['operator'] = "IN"; */
          }
        }
      }
    }
  }
}

/**
 * Query alter for moderated group content View.
 *
 * Filters by group's languages and ensures latest revision per node
 * per language.
 */
function group_country_field_views_query_alter_moderated_group(ViewExecutable $view, Sql $query) {
  $route_match = \Drupal::routeMatch();
  $group = $route_match->getParameter('group');
  if (!$group) {
    return;
  }

  if (is_numeric($group)) {
    $group = Group::load($group);
  }
  if (!$group || !$group->hasField('field_language')) {
    return;
  }

  $languages = array_column($group->get('field_language')->getValue(), 'value');
  if (empty($languages)) {
    return;
  }

  // Filter by group's languages.
  $query->addWhere(1, 'node_field_revision.langcode', $languages, 'IN');

  $input = $view->getExposedInput();
  $filtering_by_user = !empty($input['revision_uid']);

  $database = \Drupal::database();
  $subquery = $database->select('node_field_revision', 'nfr2');
  $subquery->addExpression('MAX(nfr2.vid)', 'max_vid');
  $subquery->condition('nfr2.langcode', $languages, 'IN');
  $subquery->groupBy('nfr2.nid');
  $subquery->groupBy('nfr2.langcode');

  if ($filtering_by_user) {
    // Latest revision per node per language by this user.
    $subquery->join('node_revision', 'nr2', 'nfr2.vid = nr2.vid');
    $subquery->condition('nr2.revision_uid', (int) $input['revision_uid'], '=');
  }

  $query->addWhere(1, 'node_field_revision.vid', $subquery, 'IN');
}

/**
 * Returns the languages a user may see translation jobs for.
 *
 * Users who manage translation across the whole platform are not restricted:
 * 'translate all languages' is held by editors and senior editors, 'create
 * translation jobs' by global admins and 'administer tmgmt' by site admins.
 * Everyone else is limited to the languages assigned on their profile.
 *
 * @param \Drupal\Core\Session\AccountInterface $account
 *   The account to check.
 *
 * @return string[]|null
 *   Langcodes the account may see, or NULL when it is not restricted. An empty
 *   array means the account has no assigned languages and may see nothing.
 */
function group_country_field_job_langcodes(AccountInterface $account): ?array {
  $bypass = [
    'administer tmgmt',
    'translate all languages',
    'create translation jobs',
  ];
  foreach ($bypass as $permission) {
    if ($account->hasPermission($permission)) {
      return NULL;
    }
  }

  if (!\Drupal::moduleHandler()->moduleExists('allowed_languages')) {
    return NULL;
  }

  return \Drupal::service('allowed_languages.allowed_languages_manager')
    ->assignedLanguages($account);
}

/**
 * Query alter for the TMGMT job and job item Views.
 *
 * Without this, any user who can reach the job overview sees jobs in every
 * language, not only the ones assigned to them.
 *
 * @param \Drupal\views\ViewExecutable $view
 *   The view being executed.
 * @param \Drupal\views\Plugin\views\query\Sql $query
 *   The query to alter.
 */
function group_country_field_views_query_alter_tmgmt_jobs(ViewExecutable $view, Sql $query) {
  $langcodes = group_country_field_job_langcodes(\Drupal::currentUser());
  if ($langcodes === NULL) {
    return;
  }

  $view->element['#cache']['contexts'][] = 'user';

  if (empty($langcodes)) {
    $query->addWhereExpression(0, '1 = 0');
    return;
  }

  // The job overview is built on tmgmt_job, the job item view reaches the job
  // through its tjid relationship.
  $table = $view->id() === 'tmgmt_job_overview'
    ? 'tmgmt_job'
    : $query->ensureTable('tmgmt_job', 'tjid');
  $query->addWhere(0, $table . '.target_language', $langcodes, 'IN');
}

/**
 * Implements hook_ENTITY_TYPE_access() for tmgmt_job entities.
 */
function group_country_field_tmgmt_job_access(JobInterface $entity, $operation, AccountInterface $account) {
  return group_country_field_job_language_access($entity->getTargetLangcode(), $account);
}

/**
 * Implements hook_ENTITY_TYPE_access() for tmgmt_job_item entities.
 */
function group_country_field_tmgmt_job_item_access(JobItemInterface $entity, $operation, AccountInterface $account) {
  $job = $entity->getJob();
  return group_country_field_job_language_access($job ? $job->getTargetLangcode() : NULL, $account);
}

/**
 * Denies access to a translation job outside the account's languages.
 *
 * The View query alter only hides rows; this closes the direct route to a
 * single job or job item.
 *
 * @param string|null $langcode
 *   Target language of the job, or NULL when it cannot be determined.
 * @param \Drupal\Core\Session\AccountInterface $account
 *   The account to check.
 *
 * @return \Drupal\Core\Access\AccessResultInterface
 *   Forbidden for an out of scope language, neutral otherwise.
 */
function group_country_field_job_language_access(?string $langcode, AccountInterface $account) {
  $langcodes = group_country_field_job_langcodes($account);
  if ($langcodes === NULL) {
    return AccessResult::neutral()->cachePerUser();
  }

  if ($langcode !== NULL && in_array($langcode, $langcodes, TRUE)) {
    return AccessResult::neutral()->cachePerUser();
  }

  return AccessResult::forbidden('The translation job is not in one of the languages assigned to this user.')
    ->cachePerUser();
}

/**
 * Implements hook_views_pre_render().
 */
function group_country_field_views_pre_render(ViewExecutable $view): void {
  if ($view->id() === 'duplicate_of_moderated_group_relationship') {
    $group = \Drupal::routeMatch()->getParameter('group');
    if ($group) {
      if (is_numeric($group)) {
        $group = Group::load($group);
      }
      if ($group) {
        $view->setTitle($group->label() . ' moderated content');
      }
    }
  }
}

/**
 * Implements views form alter.
 *
 * - Moderated group content: "Updated by" dropdown with members.
 * - Translation job items item id size.
 * - Country/global reports: renames date filter labels.
 */
function group_country_field_form_views_exposed_form_alter(&$form, $form_state) {
  // Remove locked system languages from language filter dropdown.
  if (isset($form['langcode']['#options'])) {
    unset($form['langcode']['#options'][LanguageInterface::LANGCODE_NOT_SPECIFIED], $form['langcode']['#options'][LanguageInterface::LANGCODE_NOT_APPLICABLE]);
  }

  // Moderated group content: populate "Updated by" with group members.
  if (isset($form['#id']) && strpos($form['#id'], 'duplicate-of-moderated-group-relationship') !== FALSE) {
    $route_match = \Drupal::routeMatch();
    $group = $route_match->getParameter('group');
    if ($group) {
      if (is_numeric($group)) {
        $group = Group::load($group);
      }
      if ($group && $group->hasField('field_language')) {
        $languages = array_column($group->get('field_language')->getValue(), 'value');
        $options = ['' => t('- Any -')];
        if (!empty($languages)) {
          $database = \Drupal::database();
          // Latest revision per node per language (matches View query).
          $sub = $database->select('node_field_revision', 'nfr2');
          $sub->addExpression('MAX(nfr2.vid)', 'max_vid');
          $sub->condition('nfr2.langcode', $languages, 'IN');
          $sub->groupBy('nfr2.nid');
          $sub->groupBy('nfr2.langcode');

          $query = $database->select('node_field_revision', 'nfr');
          $query->join('node_revision', 'nr', 'nfr.vid = nr.vid');
          $query->join('users_field_data', 'ufd', 'nr.revision_uid = ufd.uid');
          $query->fields('ufd', ['uid', 'name']);
          $query->condition('nfr.langcode', $languages, 'IN');
          $query->condition('nfr.vid', $sub, 'IN');
          $query->distinct();
          $authors = $query->execute()->fetchAllKeyed();
          asort($authors);
          foreach ($authors as $uid => $name) {
            $options[$uid] = $name;
          }
        }

        $form['revision_uid'] = [
          '#type' => 'select',
          '#title' => t('Updated by'),
          '#options' => $options,
          '#default_value' => '',
        ];
      }
    }
  }

  if ($form['#id'] == 'views-exposed-form-tmgmt-translation-all-job-items-page-1') {
    $form['item_id']['#size'] = 5;
  }
  if ($form['#id'] == 'views-exposed-form-country-reports-page-5' || $form['#id'] == 'views-exposed-form-global-reports-page-4') {
    $form['created']['min']['#title'] = t('Created From');
    $form['created']['max']['#title'] = t('Created To');
    $form['changed']['min']['#title'] = t('Updated From');
    $form['changed']['max']['#title'] = t('Updated To');
  }
}
