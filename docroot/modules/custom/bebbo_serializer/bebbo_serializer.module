<?php

/**
 * @file
 * Hook implementations for the Bebbo Serializer module.
 */

use Drupal\bebbo_serializer\Cache\ApiCacheTags;
use Drupal\bebbo_serializer\Cache\IgnoredChangeFields;
use Drupal\bebbo_serializer\Cache\RowFragmentCache;
use Drupal\Core\Cache\Cache;
use Drupal\node\NodeInterface;
use Drupal\views\ViewExecutable;
use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\Core\Entity\EntityFormInterface;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\Datetime\DrupalDateTime;
use Drupal\Core\Datetime\Element\Datetime;
use Drupal\views\Plugin\views\query\Sql;

/**
 * Implements hook_node_update().
 *
 * Expires the node's cached row fragments, per language where possible.
 *
 * Core tags a node's caches node:NID with no language in it, so without this
 * a translator saving one language would discard that node's fragments in all
 * of them — on the default site, 28 rows thrown away to rebuild one. The
 * fragments are tagged by RowFragmentCache instead, and this decides which of
 * those tags to fire:
 *
 * - an untranslatable field changed → every language, since the value is
 *   shared and each translation now renders stale;
 * - otherwise → only the translations whose stored values actually differ.
 *
 * The response-level tags are untouched: node:NID still bubbles out of
 * RowFragmentCache, so page and CDN invalidation behave exactly as before.
 */
function bebbo_serializer_node_update(NodeInterface $node): void {
  $original = $node->getOriginal();
  if ($original === NULL) {
    return;
  }

  $nid = (int) $node->id();

  $languages = array_keys($node->getTranslationLanguages());

  // A translation removed outright leaves a fragment behind with nothing to
  // compare against, and a shared value changing makes every translation
  // render differently. Both cases expire the node everywhere.
  if (_bebbo_serializer_untranslatable_changed($node, $original)
    || count($original->getTranslationLanguages()) > count($languages)) {
    Cache::invalidateTags(array_merge(
      [RowFragmentCache::anyLanguageTag($nid)],
      _bebbo_serializer_list_tags($node, array_keys($original->getTranslationLanguages() + $node->getTranslationLanguages())),
    ));
    return;
  }

  $changed = [];
  foreach ($languages as $langcode) {
    if (!$original->hasTranslation($langcode)) {
      // A translation that did not exist before cannot have a stale fragment,
      // but the row now appears in that language's listing.
      $changed[] = $langcode;
      continue;
    }
    if (_bebbo_serializer_translation_changed($node->getTranslation($langcode), $original->getTranslation($langcode))) {
      $changed[] = $langcode;
    }
  }

  if (!$changed) {
    return;
  }

  $tags = _bebbo_serializer_list_tags($node, $changed);
  foreach ($changed as $langcode) {
    $tags[] = RowFragmentCache::languageTag($nid, $langcode);
  }
  Cache::invalidateTags($tags);
}

/**
 * Implements hook_node_insert().
 *
 * A new node has no fragments yet, but every listing it belongs to is now
 * missing a row.
 */
function bebbo_serializer_node_insert(NodeInterface $node): void {
  $tags = _bebbo_serializer_list_tags($node, array_keys($node->getTranslationLanguages()));
  if ($tags) {
    Cache::invalidateTags($tags);
  }
}

/**
 * Listing tags for one node in the given languages.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The node whose bundle decides which listings are affected.
 * @param string[] $langcodes
 *   The languages whose listings must be expired.
 *
 * @return string[]
 *   Cache tags, one per language.
 */
function _bebbo_serializer_list_tags(NodeInterface $node, array $langcodes): array {
  $bundle = $node->bundle();

  return array_values(array_map(
    static fn(string $langcode): string => ApiCacheTags::listTag($bundle, $langcode),
    array_unique($langcodes),
  ));
}

/**
 * Whether any untranslatable field differs between two node revisions.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The node as saved.
 * @param \Drupal\node\NodeInterface $original
 *   The node as it was before the save.
 *
 * @return bool
 *   TRUE when a value shared by all translations changed.
 */
function _bebbo_serializer_untranslatable_changed(NodeInterface $node, NodeInterface $original): bool {
  foreach ($node->getFieldDefinitions() as $name => $definition) {
    if ($definition->isTranslatable() || $definition->isComputed()
      || in_array($name, IgnoredChangeFields::UNTRANSLATABLE, TRUE)) {
      continue;
    }
    if (!$original->hasField($name)) {
      return TRUE;
    }
    if ($node->get($name)->getValue() != $original->get($name)->getValue()) {
      return TRUE;
    }
  }
  return FALSE;
}

/**
 * Whether a single translation's translatable values changed.
 *
 * @param \Drupal\node\NodeInterface $translation
 *   The translation as saved.
 * @param \Drupal\node\NodeInterface $original
 *   The same translation before the save.
 *
 * @return bool
 *   TRUE when this language's rendered row can no longer be trusted.
 */
function _bebbo_serializer_translation_changed(NodeInterface $translation, NodeInterface $original): bool {
  foreach ($translation->getFieldDefinitions() as $name => $definition) {
    if (!$definition->isTranslatable() || $definition->isComputed()
      || in_array($name, IgnoredChangeFields::TRANSLATABLE, TRUE)) {
      continue;
    }
    if (!$original->hasField($name)) {
      return TRUE;
    }
    if ($translation->get($name)->getValue() != $original->get($name)->getValue()) {
      return TRUE;
    }
  }
  return FALSE;
}

/**
 * Implements hook_node_predelete().
 *
 * Deletes orphaned quiz_questions nodes when a Quiz node is deleted.
 * IEF handles removal during form interaction (removed_reference: delete),
 * but direct Quiz deletion would orphan the referenced question nodes.
 */
function bebbo_serializer_node_predelete(NodeInterface $node): void {
  // The row is gone in every language, so no per-language reasoning applies.
  Cache::invalidateTags(array_merge(
    [RowFragmentCache::anyLanguageTag((int) $node->id())],
    _bebbo_serializer_list_tags($node, array_keys($node->getTranslationLanguages())),
  ));

  if ($node->bundle() !== 'quiz') {
    return;
  }

  if (!$node->hasField('field_quiz_questions') || $node->get('field_quiz_questions')->isEmpty()) {
    return;
  }

  $question_ids = array_column($node->get('field_quiz_questions')->getValue(), 'target_id');
  if (empty($question_ids)) {
    return;
  }

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $questions = $storage->loadMultiple($question_ids);
  $storage->delete($questions);
}

/**
 * Implements hook_views_query_alter().
 *
 * When ?pregnancy=true is present on the articles endpoint, adds the
 * Pregnancy term TID to the child_age filter so pregnancy-tagged
 * articles are included in the results.
 */
function bebbo_serializer_views_query_alter(ViewExecutable $view, QueryPluginBase $query): void {
  if (!$query instanceof Sql) {
    return;
  }
  $article_displays = [
    'bebbo_v2_apis' => 'articles_rest_export',
    'bebbo_v1_apis' => 'v1_articles_rest_export',
  ];
  if (!isset($article_displays[$view->id()]) || $view->current_display !== $article_displays[$view->id()]) {
    return;
  }

  $pregnancy_param = \Drupal::request()->query->get('pregnancy');
  if ($pregnancy_param !== 'true') {
    return;
  }

  $cid = 'bebbo_serializer:pregnancy_tid';
  $cache = \Drupal::cache()->get($cid);
  if ($cache) {
    $pregnancy_tid = (string) $cache->data;
  }
  else {
    $terms = \Drupal::entityTypeManager()
      ->getStorage('taxonomy_term')
      ->loadByProperties(['name' => 'Pregnancy', 'vid' => 'child_age']);
    if (empty($terms)) {
      return;
    }
    $pregnancy_tid = (string) reset($terms)->id();
    \Drupal::cache()->set($cid, $pregnancy_tid, -1, ['taxonomy_term_list']);
  }

  // Traverse the query's WHERE conditions to find the child_age filter
  // and add the Pregnancy TID to its IN() list.
  // The taxonomy_index_tid filter uses operator "formula" with a nested
  // value array keyed by a placeholder name.
  foreach ($query->where as &$group) {
    if (empty($group['conditions'])) {
      continue;
    }
    foreach ($group['conditions'] as &$condition) {
      if (!isset($condition['field']) || !is_string($condition['field'])) {
        continue;
      }
      if (!str_contains($condition['field'], 'field_child_age_target_id')) {
        continue;
      }
      // Values are nested: [':placeholder[]' => [43 => 43, ...]].
      foreach ($condition['value'] as &$values) {
        if (is_array($values) && !isset($values[$pregnancy_tid])) {
          $values[$pregnancy_tid] = $pregnancy_tid;
        }
      }
    }
  }
}

/**
 * Implements hook_node_presave().
 *
 * Auto-populates field_embedded_images by extracting image URLs
 * from <drupal-media> and <img> tags in the body field.
 *
 * Auto-populates field_body_rendered with pre-rendered body HTML
 * (drupal-media converted to img tags) for article nodes.
 */
function bebbo_serializer_node_presave(NodeInterface $node): void {
  // Auto-compute entity reference counts for course and quiz nodes.
  _bebbo_serializer_populate_number_of_modules($node);
  _bebbo_serializer_populate_number_of_questions($node);

  // Truncate height/weight decimals to max 2 places (no rounding).
  if ($node->bundle() === 'pregnancy_weekly_overview') {
    foreach (['field_average_height', 'field_average_weight'] as $field_name) {
      if ($node->hasField($field_name) && !$node->get($field_name)->isEmpty()) {
        $truncated = _bebbo_serializer_truncate_decimal($node->get($field_name)->value);
        $node->set($field_name, $truncated);
      }
    }
  }

  // Process every moderation state, not only published nodes: the reports
  // export reads field_body_rendered, so drafts need it populated too.
  if (!$node->hasField('body')) {
    return;
  }

  $body = $node->get('body')->value ?? '';
  $original_body = '';
  if (!$node->isNew() && isset($node->original)) {
    $original_body = $node->original->get('body')->value ?? '';
  }

  // Embedded images are only consumed by the API, which serves published
  // content, so there is nothing to gain from extracting them on drafts.
  if ($node->isPublished()) {
    _bebbo_serializer_populate_embedded_images($node, $body, $original_body);
  }
  _bebbo_serializer_populate_body_rendered($node, $body, $original_body);
}

/**
 * Populates field_embedded_images from <drupal-media> and <img> tags in body.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The node being saved.
 * @param string $body
 *   Current body value.
 * @param string $original_body
 *   Original body value (empty for new nodes).
 */
function _bebbo_serializer_populate_embedded_images(NodeInterface $node, string $body, string $original_body): void {
  $supported_types = ['activities', 'article', 'page', 'video_article'];

  if (!in_array($node->bundle(), $supported_types, TRUE)) {
    return;
  }

  if (!$node->hasField('field_embedded_images')) {
    return;
  }

  // Skip extraction entirely if body hasn't changed and field is populated.
  $existing = array_column($node->get('field_embedded_images')->getValue(), 'value');
  if ($body === $original_body && !empty($existing)) {
    return;
  }

  // Clear field if body is empty or has no embedded images.
  $hasDrupalMedia = strpos($body, '<drupal-media') !== FALSE;
  $hasImgTags = stripos($body, '<img') !== FALSE;
  if (empty($body) || (!$hasDrupalMedia && !$hasImgTags)) {
    if (!empty($existing)) {
      $node->set('field_embedded_images', []);
    }
    return;
  }

  /** @var \Drupal\bebbo_serializer\Service\BodyImageProcessor $processor */
  $processor = \Drupal::service('bebbo_serializer.body_image_processor');
  $urls = $processor->extractImageUrls($body);

  // field_embedded_images is a 255 character string field. Legacy bodies still
  // carry signed S3 URLs well over that, and storing one aborts the node save
  // with an SQL truncation error, so drop them instead.
  $urls = array_values(array_filter($urls, static fn(string $url): bool => mb_strlen($url) <= 255));

  // Only update field if URLs actually changed.
  if ($urls === $existing) {
    return;
  }

  $node->set('field_embedded_images', $urls);
}

/**
 * Populates field_body_rendered with pre-rendered body HTML for articles.
 *
 * Runs the body through check_markup() to convert <drupal-media> to <img>,
 * then applies cleanup for API output. This moves the rendering work from
 * request time (Views) to save time.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The node being saved.
 * @param string $body
 *   Current body value.
 * @param string $original_body
 *   Original body value (empty for new nodes).
 */
function _bebbo_serializer_populate_body_rendered(NodeInterface $node, string $body, string $original_body): void {
  // Guard: skip content types that don't have the field.
  if (!$node->hasField('field_body_rendered')) {
    return;
  }

  // Skip rendering if body hasn't changed and field is already populated.
  $existing = $node->get('field_body_rendered')->value ?? '';
  if ($body === $original_body && !empty($existing)) {
    return;
  }

  // Clear field if body is empty.
  if (empty($body)) {
    if (!empty($existing)) {
      $node->set('field_body_rendered', NULL);
    }
    return;
  }

  $bodyFormat = $node->get('body')->format ?? 'full_html';
  $langcode = $node->language()->getId();
  $baseUrl = \Drupal::request()->getSchemeAndHttpHost();

  /** @var \Drupal\bebbo_serializer\Service\BodyImageProcessor $processor */
  $processor = \Drupal::service('bebbo_serializer.body_image_processor');
  $rendered = $processor->render($body, $bodyFormat, $langcode, $baseUrl);

  // Only update if the rendered value actually changed.
  if ($rendered === $existing) {
    return;
  }

  $node->set('field_body_rendered', [
    'value' => $rendered,
    'format' => 'full_html',
  ]);
}

/**
 * Sets field_number_of_modules from field_course_modules entity ref count.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The node being saved.
 */
function _bebbo_serializer_populate_number_of_modules(NodeInterface $node): void {
  if ($node->bundle() !== 'course') {
    return;
  }

  if (!$node->hasField('field_course_modules') || !$node->hasField('field_number_of_modules')) {
    return;
  }

  $count = $node->get('field_course_modules')->count();
  $node->set('field_number_of_modules', $count);
}

/**
 * Sets field_number_of_questions from field_quiz_questions count.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The node being saved.
 */
function _bebbo_serializer_populate_number_of_questions(NodeInterface $node): void {
  if ($node->bundle() !== 'quiz') {
    return;
  }

  if (!$node->hasField('field_quiz_questions') || !$node->hasField('field_number_of_questions')) {
    return;
  }

  $count = $node->get('field_quiz_questions')->count();
  $node->set('field_number_of_questions', $count);
}

/**
 * Implements hook_form_alter().
 *
 * Makes paragraph count fields readonly and attaches JS for real-time
 * updates on course and quiz node forms.
 */
function bebbo_serializer_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  // Course: auto-compute number of modules, validate expiry date.
  if (in_array($form_id, ['node_course_form', 'node_course_edit_form'], TRUE)) {
    if (isset($form['field_number_of_modules'])) {
      $form['field_number_of_modules']['#disabled'] = TRUE;
    }
    $form['#attached']['library'][] = 'bebbo_serializer/course_module_count';
    $form['#attached']['library'][] = 'bebbo_serializer/course_expiry';
    $form['#validate'][] = '_bebbo_serializer_course_expiry_validate';
    $form['#validate'][] = '_bebbo_serializer_course_link_validate';

    // Default an omitted expiry time to end of day. This has to happen in the
    // value callback: by the time any validator runs, core has already failed
    // to build a date from "Y-m-d H:i:s" against a date-only string and left
    // the raw array in place. course_expiry.js goes further and rewrites the
    // time whenever the date changes; this only covers the empty case, which
    // is all a submission can tell us about.
    if (isset($form['field_course_expiry']['widget'][0]['value'])) {
      $form['field_course_expiry']['widget'][0]['value']['#value_callback'] = '_bebbo_serializer_course_expiry_value';
    }
  }

  // Pregnancy weekly overview: restrict.
  // height/weight to 2 decimal places in real-time.
  if (in_array($form_id, ['node_pregnancy_weekly_overview_form', 'node_pregnancy_weekly_overview_edit_form'], TRUE)) {
    $form['#attached']['library'][] = 'bebbo_serializer/decimal-restriction';
  }

  // Quiz: auto-compute number of questions, validate passing score.
  if (in_array($form_id, ['node_quiz_form', 'node_quiz_edit_form'], TRUE)) {
    if (isset($form['field_number_of_questions'])) {
      $form['field_number_of_questions']['#disabled'] = TRUE;
    }
    if (isset($form['field_passing_score'])) {
      $form_object = $form_state->getFormObject();
      $count = 0;
      if ($form_object instanceof EntityFormInterface) {
        $node = $form_object->getEntity();
        if ($node instanceof NodeInterface && $node->hasField('field_quiz_questions')) {
          $count = $node->get('field_quiz_questions')->count();
        }
      }
      $form['field_passing_score']['widget'][0]['value']['#description'] = t('The passing score out of @count', ['@count' => $count]);
    }
    $form['#validate'][] = '_bebbo_serializer_quiz_passing_score_validate';
    $form['#validate'][] = '_bebbo_serializer_quiz_question_count_validate';
    $form['#attached']['library'][] = 'bebbo_serializer/quiz_question_count';
    $form['#attached']['drupalSettings']['bebboQuizType'] = [
      'singleQuestionValue' => 'single_question_quiz',
    ];
    _bebbo_serializer_rename_ief_buttons($form, 'field_quiz_questions', t('quiz question'));
  }
}

/**
 * Implements hook_inline_entity_form_translation_restrict_alter().
 *
 * Allows adding new course modules on translation forms.
 */
function bebbo_serializer_inline_entity_form_translation_restrict_alter(bool &$restrict, array $element, FieldDefinitionInterface $field_definition): void {
  if ($field_definition->getName() === 'field_course_modules') {
    $restrict = FALSE;
  }
}

/**
 * Implements hook_inline_entity_form_entity_form_alter().
 *
 * Renames "Add another item" to "Add another answer" on quiz question forms.
 */
function bebbo_serializer_inline_entity_form_entity_form_alter(array &$entity_form, FormStateInterface &$form_state): void {
  if (($entity_form['#bundle'] ?? '') !== 'quiz_questions') {
    return;
  }
  if (!isset($entity_form['field_answers']['widget']['add_more'])) {
    return;
  }
  $add_more = &$entity_form['field_answers']['widget']['add_more'];
  // Simple button.
  if (isset($add_more['#value'])) {
    $add_more['#value'] = t('Add another answer');
    return;
  }
  // Drupal 10.2+ wraps add_more in a container.
  foreach (Element::children($add_more) as $key) {
    if (isset($add_more[$key]['#value'])) {
      $add_more[$key]['#value'] = t('Add another answer');
    }
  }
}

/**
 * Renames IEF complex widget buttons to use a human-readable label.
 *
 * @param array $form
 *   The form render array.
 * @param string $field_name
 *   The entity reference field using IEF.
 * @param \Drupal\Core\StringTranslation\TranslatableMarkup|string $label
 *   The label to display (e.g. "Question").
 */
function _bebbo_serializer_rename_ief_buttons(array &$form, string $field_name, $label): void {
  if (!isset($form[$field_name]['widget'])) {
    return;
  }
  $widget = &$form[$field_name]['widget'];

  foreach (Element::children($widget) as $key) {
    if (isset($widget[$key]['actions']['ief_add'])) {
      $widget[$key]['actions']['ief_add']['#value'] = t('Add @label', ['@label' => $label]);
    }
    if (isset($widget[$key]['form']['inline_entity_form']['actions']['ief_add_save'])) {
      $widget[$key]['form']['inline_entity_form']['actions']['ief_add_save']['#value'] = t('Add @label', ['@label' => $label]);
    }
  }

  // Also check top-level actions (varies by IEF version).
  if (isset($widget['actions']['ief_add'])) {
    $widget['actions']['ief_add']['#value'] = t('Add @label', ['@label' => $label]);
  }
}

/**
 * Counts quiz question entities from IEF widget internal state.
 *
 * The field_number_of_questions widget is #disabled so Drupal resets its
 * submitted value to the default. This helper counts entities from the
 * IEF complex widget's form state storage.
 */
function _bebbo_serializer_count_questions(array $form, FormStateInterface $form_state): int {
  if (!isset($form['field_quiz_questions']['widget']['#ief_id'])) {
    return 0;
  }

  $ief_id = $form['field_quiz_questions']['widget']['#ief_id'];
  $entities = $form_state->get(['inline_entity_form', $ief_id, 'entities']) ?? [];

  return count($entities);
}

/**
 * Validates that passing score does not exceed the number of questions.
 */
function _bebbo_serializer_quiz_passing_score_validate(array &$form, FormStateInterface $form_state): void {
  $passing_score = (int) $form_state->getValue(['field_passing_score', 0, 'value']);
  $question_count = _bebbo_serializer_count_questions($form, $form_state);

  if ($passing_score > $question_count) {
    $form_state->setErrorByName(
      'field_passing_score',
      t('Passing score (@score) cannot exceed the number of questions (@count).', [
        '@score' => $passing_score,
        '@count' => $question_count,
      ])
    );
  }
}

/**
 * Validates that a single question quiz has at most one question.
 */
function _bebbo_serializer_quiz_question_count_validate(array &$form, FormStateInterface $form_state): void {
  $quiz_type = $form_state->getValue(['field_quiz_type', 0, 'value']);
  if ($quiz_type !== 'single_question_quiz') {
    return;
  }

  $question_count = _bebbo_serializer_count_questions($form, $form_state);

  if ($question_count > 1) {
    $form_state->setErrorByName(
      'field_quiz_questions',
      t('To change the quiz type to “Single question quiz,” the “Questions” section must contain only one question. Please remove all additional questions before changing to this quiz type.')
    );
  }
}

/**
 * Value callback for the course expiry element.
 *
 * Fills in an end-of-day time when the editor supplies a date on its own, so
 * "expires on the 10th" means the whole of the 10th rather than midnight at
 * its start. Runs ahead of validation, so the defaulted value is what gets
 * validated and saved.
 *
 * @param array $element
 *   The datetime form element.
 * @param mixed $input
 *   Submitted input, or FALSE when the form is being built.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The form state.
 *
 * @return array
 *   The datetime element value, as built by the core value callback.
 */
function _bebbo_serializer_course_expiry_value(array &$element, $input, FormStateInterface $form_state): array {
  if (is_array($input) && !empty($input['date']) && empty($input['time'])) {
    $input['time'] = '23:59:59';
  }

  return Datetime::valueCallback($element, $input, $form_state);
}

/**
 * Validates that the course expiry date is in the future.
 */
function _bebbo_serializer_course_expiry_validate(array &$form, FormStateInterface $form_state): void {
  $expiry = $form_state->getValue(['field_course_expiry', 0, 'value']);
  if (empty($expiry)) {
    return;
  }

  // A date the editor never completed stays an array here; core has already
  // flagged it, so there is nothing useful left to check.
  if (is_array($expiry)) {
    return;
  }

  $expiry_date = $expiry instanceof DrupalDateTime ? $expiry : new DrupalDateTime($expiry);
  $now = new DrupalDateTime('now');

  if ($expiry_date <= $now) {
    $form_state->setErrorByName(
      'field_course_expiry',
      t('Course expiry date must be in the future.')
    );
  }
}

/**
 * Validates that the course link is a valid URL.
 */
function _bebbo_serializer_course_link_validate(array &$form, FormStateInterface $form_state): void {
  $link = $form_state->getValue(['field_course_link', 0, 'value']);
  if (empty($link)) {
    return;
  }

  // FILTER_VALIDATE_URL alone accepts any scheme with an authority, ftp://
  // included. App users can only follow a web link, so restrict it.
  $scheme = strtolower((string) parse_url($link, PHP_URL_SCHEME));
  if (!filter_var($link, FILTER_VALIDATE_URL) || !in_array($scheme, ['http', 'https'], TRUE)) {
    $form_state->setErrorByName(
      'field_course_link',
      t('Please enter a valid URL for the course link, starting with http:// or https:// (e.g. https://example.com).')
    );
  }
}

/**
 * Truncates a decimal value to at most 2 decimal places without rounding.
 */
function _bebbo_serializer_truncate_decimal($value): ?string {
  if ($value === NULL || $value === '') {
    return $value;
  }

  $str = (string) $value;
  $dot = strpos($str, '.');
  if ($dot === FALSE) {
    return $str;
  }

  return substr($str, 0, $dot + 3);
}
