+        '@key' => $key,
+        '@message' => $exception->getMessage(),
+      ]);
+      $jobItem->addMessage('Translation of @key failed and was returned to the queue for cron to retry: @message', [
+        '@key' => $key,
+        '@message' => $exception->getMessage(),
+      ], 'error');
+      if (isset($queue_item->item_id) && $queue_item->item_id) {
+        \Drupal::service('queue')->get('ai_translator_worker', TRUE)->releaseItem($queue_item);
+      }
+      return;
+    }
     if (!isset($context['results'][$job_item_id]['translation'])) {
       $context['results'][$job_item_id]['translation'] = [];
     }
