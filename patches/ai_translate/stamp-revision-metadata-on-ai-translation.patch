diff --git a/src/TranslationRevisionStampTrait.php b/src/TranslationRevisionStampTrait.php
new file mode 100644
index 0000000..ec57bd2
--- /dev/null
+++ b/src/TranslationRevisionStampTrait.php
@@ -0,0 +1,49 @@
+<?php
+
+namespace Drupal\ai_translate;
+
+use Drupal\Core\Entity\EntityChangedInterface;
+use Drupal\Core\Entity\EntityInterface;
+use Drupal\Core\Entity\RevisionLogInterface;
+
+/**
+ * Stamps revision metadata on AI generated translations.
+ *
+ * Core only sets the revision creation time, revision author, revision log
+ * message and changed time in entity forms, so a programmatic save copies
+ * those values from the source revision. Without this, an AI translation
+ * creates a revision that claims to have been made by the previous editor at
+ * the time of the previous edit, with no log entry - which also breaks any
+ * view sorted on the changed time.
+ *
+ * Host classes must provide $this->time, $this->currentUser,
+ * $this->languageManager and the t() method.
+ */
+trait TranslationRevisionStampTrait {
+
+  /**
+   * Records who created a translation revision, when, and why.
+   *
+   * @param \Drupal\Core\Entity\EntityInterface $translation
+   *   The unsaved translation.
+   * @param string $langcode
+   *   Language code of the translation.
+   */
+  protected function stampTranslationRevision(EntityInterface $translation, string $langcode): void {
+    $request_time = $this->time->getRequestTime();
+
+    if ($translation instanceof RevisionLogInterface) {
+      $translation->setRevisionCreationTime($request_time);
+      $translation->setRevisionUserId($this->currentUser->id());
+      $language = $this->languageManager->getLanguage($langcode);
+      $translation->setRevisionLogMessage((string) $this->t('AI translated to @language.', [
+        '@language' => $language ? $language->getName() : $langcode,
+      ]));
+    }
+
+    if ($translation instanceof EntityChangedInterface) {
+      $translation->setChangedTime($request_time);
+    }
+  }
+
+}
