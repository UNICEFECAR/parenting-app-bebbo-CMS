+  /**
+   * Records who created a translation revision, when, and why.
+   *
+   * Core only sets the revision creation time, revision author, revision log
+   * message and changed time in entity forms, so a programmatic save copies
+   * those values from the source revision. Without this, an AI translation
+   * creates a revision that claims to have been made by the previous editor
+   * at the time of the previous edit, with no log entry - which also breaks
+   * any view sorted on the changed time.
+   *
+   * @param \Drupal\Core\Entity\ContentEntityInterface $translation
+   *   The unsaved translation.
+   * @param string $langcode
+   *   Language code of the translation.
+   */
+  protected function stampTranslationRevision(ContentEntityInterface $translation, string $langcode): void {
+    $request_time = $this->time->getRequestTime();
+
+    if ($translation instanceof RevisionLogInterface) {
+      $translation->setRevisionCreationTime($request_time);
+      $translation->setRevisionUserId($this->currentUser->id());
+      $language = $this->languageManager->getLanguage($langcode);
+      $translation->setRevisionLogMessage((string) $this->t('AI translated to @language.', [
+        '@language' => $language ? $language->getName() : $langcode,
+      ]));
+    }
+
+    if ($translation instanceof EntityChangedInterface) {
+      $translation->setChangedTime($request_time);
+    }
+  }
